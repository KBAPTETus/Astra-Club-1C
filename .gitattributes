# ==============================================================================
# .gitattributes для платформы 1С:Предприятие 8.3
# ==============================================================================

# Автоматическое определение текстовых файлов
* text=auto

# Исходный код на встроенном языке BSL и выгрузка метаданных XML
*.bsl text eol=crlf
*.xml text eol=crlf
*.json text eol=lf
*.md text eol=lf

# Бинарные файлы платформы 1С
*.cf binary
*.dt binary
*.epf binary
*.erf binary
*.1CD binary
