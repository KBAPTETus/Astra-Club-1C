&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// При создании нового документа подставляем текущее время и 1 час по умолчанию
	Если Объект.Ссылка.Пустая() И Не ЗначениеЗаполнено(Объект.ВремяНачала) Тогда
		Объект.ВремяНачала    = ТекущаяДата();
		Объект.Длительность   = 1;
		Объект.ВремяОкончания = Объект.ВремяНачала + 3600;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВремяНачалаПриИзменении(Элемент)
	РассчитатьОкончаниеИСтоимостьСессии();
КонецПроцедуры

&НаКлиенте
Процедура ДлительностьПриИзменении(Элемент)
	РассчитатьОкончаниеИСтоимостьСессии();
КонецПроцедуры

&НаКлиенте
Процедура ТарифПриИзменении(Элемент)
	// Подтягиваем актуальную цену тарифа из регистра сведений на сервере без контекста
	Объект.ЦенаТарифа = ПолучитьАктуальнуюЦенуНаСервере(Объект.Тариф, Объект.Дата);
	РассчитатьОкончаниеИСтоимостьСессии();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыБараНоменклатураПриИзменении(Элемент)
	ТекСтрока = Элементы.ТоварыБара.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ТекСтрока.Цена = ПолучитьАктуальнуюЦенуНаСервере(ТекСтрока.Номенклатура, Объект.Дата);
		Если ТекСтрока.Количество = 0 Тогда
			ТекСтрока.Количество = 1;
		КонецЕсли;
		ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.Цена;
	КонецЕсли;
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыБараКоличествоПриИзменении(Элемент)
	ПересчитатьСтрокуБара();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыБараЦенаПриИзменении(Элемент)
	ПересчитатьСтрокуБара();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуБара()
	ТекСтрока = Элементы.ТоварыБара.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.Цена;
	КонецЕсли;
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьОкончаниеИСтоимостьСессии()
	Если ЗначениеЗаполнено(Объект.ВремяНачала) И Объект.Длительность > 0 Тогда
		// В 1С дата измеряется в секундах, поэтому часы умножаем на 3600
		Объект.ВремяОкончания = Объект.ВремяНачала + Объект.Длительность * 3600;
	КонецЕсли;
	
	Объект.СуммаУслуг = Объект.Длительность * Объект.ЦенаТарифа;
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтоги()
	СуммаБара = 0;
	Для Каждого Стр Из Объект.ТоварыБара Цикл
		СуммаБара = СуммаБара + Стр.Сумма;
	КонецЦикла;
	
	Объект.СуммаБара  = СуммаБара;
	Объект.ВсегоСумма = Объект.СуммаУслуг + Объект.СуммаБара;
КонецПроцедуры

// Функция получения цены из регистра сведений на дату документа
&НаСервереБезКонтекста
Функция ПолучитьАктуальнуюЦенуНаСервере(Номенклатура, ДатаСреза)
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат 0;
	КонецЕсли;
	
	Отбор = Новый Структура("Номенклатура", Номенклатура);
	ЗначенияЦен = РегистрыСведений.ЦеныНоменклатуры.СрезПоследних(ДатаСреза, Отбор);
	
	Если ЗначенияЦен.Количество() > 0 Тогда
		Возврат ЗначенияЦен[0].Цена;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции