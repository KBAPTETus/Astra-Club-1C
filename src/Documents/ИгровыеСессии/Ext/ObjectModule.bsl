Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Включаем запись движений по регистрам
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	
	// 1. Проверка статуса игрового места и его занятие
	Если ЗначениеЗаполнено(ИгровоеМесто) Тогда
		Если ИгровоеМесто.Статус = Перечисления.СтатусПКМеста.Занято Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Игровое место ""%1"" уже занято!", ИгровоеМесто);
			Сообщение.Поле = "ИгровоеМесто";
			Сообщение.Сообщить();
			Возврат;
		ИначеЕсли ИгровоеМесто.Статус = Перечисления.СтатусПКМеста.Недоступно Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Игровое место ""%1"" находится на техобслуживании и недоступно!", ИгровоеМесто);
			Сообщение.Поле = "ИгровоеМесто";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		
		// Переводим статус места в "Занято"
		ОбъектМеста = ИгровоеМесто.ПолучитьОбъект();
		ОбъектМеста.Статус = Перечисления.СтатусПКМеста.Занято;
		ОбъектМеста.Записать();
	КонецЕсли;
	
	// 2. Фиксация продажи услуги (Игровое время)
	Если ЗначениеЗаполнено(Тариф) И СуммаУслуг > 0 Тогда
		ДвПродажи = Движения.Продажи.Добавить();
		ДвПродажи.Период       = Дата;
		ДвПродажи.Номенклатура = Тариф;
		// Пишем точное количество часов (Длительность), а не просто 1
		ДвПродажи.Количество   = Длительность;
		ДвПродажи.Выручка      = СуммаУслуг;
	КонецЕсли;
	
	// 3. Движения по товарам бара (если гость заказывал напитки/снеки)
	Для Каждого СтрБара Из ТоварыБара Цикл
		
		// Расход со склада
		ДвОстатки = Движения.ОстаткиТоваров.ДобавитьРасход();
		ДвОстатки.Период       = Дата;
		ДвОстатки.Номенклатура = СтрБара.Номенклатура;
		ДвОстатки.Склад        = Склад;
		ДвОстатки.Количество   = СтрБара.Количество;
		
		// Фиксация выручки бара
		ДвПродажи = Движения.Продажи.Добавить();
		ДвПродажи.Период       = Дата;
		ДвПродажи.Номенклатура = СтрБара.Номенклатура;
		ДвПродажи.Количество   = СтрБара.Количество;
		ДвПродажи.Выручка      = СтрБара.Сумма;
		
	КонецЦикла;
	
	// Записываем сформированные движения перед контролем остатков
	Движения.ОстаткиТоваров.Записать();
	
	// 4. Контроль отрицательных остатков (Современная методика 1С)
	Если ТоварыБара.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ОстаткиТоваровОстатки.Номенклатура КАК Номенклатура,
			|	ОстаткиТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.ОстаткиТоваров.Остатки(
			|			&МоментВремени,
			|			Склад = &Склад
			|				И Номенклатура В
			|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|						Док.Номенклатура
			|					ИЗ
			|						Документ.ИгровыеСессии.ТоварыБара КАК Док
			|					ГДЕ
			|						Док.Ссылка = &Ссылка)) КАК ОстаткиТоваровОстатки
			|ГДЕ
			|	ОстаткиТоваровОстатки.КоличествоОстаток < 0";
		
		Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"Недостаточно товара ""%1"" на складе! Не хватает: %2 шт.",
				Выборка.Номенклатура,
				-Выборка.КоличествоОстаток
			);
			Сообщение.Сообщить();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// При отмене проведения освобождаем игровое место
	Если ЗначениеЗаполнено(ИгровоеМесто) Тогда
		ОбъектМеста = ИгровоеМесто.ПолучитьОбъект();
		ОбъектМеста.Статус = Перечисления.СтатусПКМеста.Свободно;
		ОбъектМеста.Записать();
	КонецЕсли;
	
КонецПроцедуры
