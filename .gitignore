# или демо-базу build/КомпьютерныйКлубАстра_ДемоБаза.dt, либо загрузку из src/
1Cv8.1CD
1Cv8*.1CD

# Временные файлы, кэш и блокировки 1С
*.cfl
*.1CL
*.cgr
*.lck
*.tmp
*.pfl

# Журнал регистрации и служебные логи
1Cv8Log/
*.lgp
*.lgf

# Планировщик заданий и фоновые процессы
1Cv8JobScheduler/

# Полнотекстовый поиск
1Cv8FTxt/

# Сессии и синхронизация конфигуратора
1Cv8snc.*
1Cv8tmp.*

# Временные лог-файлы пакетных операций
*.log

# Служебные файлы операционных систем
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# Настройки IDE
.idea/
.vscode/
