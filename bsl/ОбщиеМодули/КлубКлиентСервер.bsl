#Область ПрограммныйИнтерфейс

// Рассчитывает дату и время окончания игровой сессии исходя из длительности в часах.
// 
// Параметры:
//   ВремяНачала  - Дата  - Время старта сессии
//   Длительность - Число - Количество часов аренды
// 
// Возвращаемое значение:
//   Дата - Время окончания сессии
//
Функция РассчитатьВремяОкончания(ВремяНачала, Длительность) Экспорт
	
	Если Не ЗначениеЗаполнено(ВремяНачала) Или Длительность <= 0 Тогда
		Возврат ВремяНачала;
	КонецЕсли;
	
	Возврат ВремяНачала + Длительность * 3600;
	
КонецФункции

// Форматирует длительность сессии в человекочитаемый вид
//
// Параметры:
//   Часы - Число - Количество часов
//
// Возвращаемое значение:
//   Строка - Пример: "2 ч."
//
Функция ФорматироватьДлительность(Часы) Экспорт
	
	Возврат СтрШаблон("%1 ч.", Часы);
	
КонецФункции

#КонецОбласти
